; PREPARATION ONLY. Keep Asterisk masked until Beeline authorizes the server IP.
; On activation, replace the placeholder host values from the operator's current sheet.

[transport-callbridge]
type=transport
protocol=udp
bind=127.0.0.1:5070

[skorozvon-callbridge]
type=endpoint
transport=transport-callbridge
context=from-skorozvon-callbridge
disallow=all
allow=alaw,ulaw
direct_media=no

[skorozvon-callbridge-identify]
type=identify
endpoint=skorozvon-callbridge
match=SKOROZVON_SIP_SOURCE_IP

[beeline-trunk-1]
type=endpoint
transport=transport-callbridge
context=from-beeline-callbridge
disallow=all
allow=alaw,ulaw
aors=beeline-trunk-1-aor
direct_media=no
from_domain=voip.beeline.ru

[beeline-trunk-1-aor]
type=aor
contact=sip:voip.beeline.ru:5060

[beeline-trunk-1-identify]
type=identify
endpoint=beeline-trunk-1
match=voip.beeline.ru

[beeline-trunk-2]
type=endpoint
transport=transport-callbridge
context=from-beeline-callbridge
disallow=all
allow=alaw,ulaw
aors=beeline-trunk-2-aor
direct_media=no
from_domain=62.105.132.84

[beeline-trunk-2-aor]
type=aor
contact=sip:62.105.132.84:5066

[beeline-trunk-2-identify]
type=identify
endpoint=beeline-trunk-2
match=62.105.132.84
