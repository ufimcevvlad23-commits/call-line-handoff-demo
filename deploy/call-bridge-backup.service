[Unit]
Description=Backup Call Bridge SQLite database
After=skorozvon-call-bridge.service

[Service]
Type=oneshot
User=callbridge
Group=callbridge
WorkingDirectory=/opt/skorozvon-bitrix-call-bridge
EnvironmentFile=/opt/skorozvon-bitrix-call-bridge/.env.production
ExecStart=/usr/local/bin/node --env-file=/opt/skorozvon-bitrix-call-bridge/.env.production scripts/backup-db.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=skorozvon-call-bridge
UMask=0027
