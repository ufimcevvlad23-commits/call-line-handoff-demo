[Unit]
Description=Skorozvon to Bitrix24 call bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=callbridge
Group=callbridge
WorkingDirectory=/opt/skorozvon-bitrix-call-bridge
EnvironmentFile=/opt/skorozvon-bitrix-call-bridge/.env.production
ExecStart=/usr/local/bin/node --env-file=/opt/skorozvon-bitrix-call-bridge/.env.production server.js
Restart=on-failure
RestartSec=3
StateDirectory=skorozvon-call-bridge
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
